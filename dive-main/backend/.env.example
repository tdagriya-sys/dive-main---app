NODE_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Leave MONGO_URL empty to use an in-memory MongoDB for local dev (data resets on restart).
# Point this at a real MongoDB (local `mongod` or Atlas) once you have one.
MONGO_URL=
DB_NAME=dive

JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OTP_TTL_MINUTES=5
MIN_SIGNUP_AGE=18

# Comma-separated list of account emails allowed to call admin-only endpoints
# (currently just POST /api/admin/instruments/refresh). Leave empty and no
# one can call them, including you — put your own signup email here once
# you've signed up.
ADMIN_EMAILS=

# See /docs/GETTING_API_KEYS.md for how to get each of these for real.
# While these are left as placeholders, the app runs in dev/mock mode automatically.
# OTP codes are delivered by email (via Resend) — no approval/template wait,
# works the moment a real key is set here.
EMAIL_API_KEY=REPLACE_WITH_YOUR_KEY
# Optional — defaults to Resend's own shared test address if left unset.
# Only needs changing once you've verified your own domain in Resend.
EMAIL_FROM=
CRYPTO_PRICE_API_KEY=REPLACE_WITH_YOUR_KEY

# Powers AI-based holdings extraction for the Bot Scanner and image/PDF file
# uploads (Claude vision + structured output). Without a real key those two
# ingestion paths return a clear "not configured" error rather than guessing.
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_KEY

FINVU_BASE_URL=https://finvu-sandbox.example/api
FINVU_CLIENT_ID=REPLACE_ME
FINVU_CLIENT_SECRET=REPLACE_ME
FINVU_CERT_PATH=

PUBLIC_BASE_URL=http://localhost:8000
