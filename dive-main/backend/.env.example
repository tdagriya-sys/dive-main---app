NODE_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Leave MONGO_URL empty to use an in-memory MongoDB for local dev (data resets on restart).
# Point this at a real MongoDB (local `mongod` or Atlas) once you have one.
MONGO_URL=
# Use a DEDICATED database name for dev/staging so local work never touches the
# live `dive` data (see docs/ADMIN_PANEL_SETUP_GUIDE.md §0). Production keeps `dive`.
DB_NAME=dive_staging

JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OTP_TTL_MINUTES=5
MIN_SIGNUP_AGE=18

# Comma-separated list of account emails allowed to call admin-only endpoints
# (currently just POST /api/admin/instruments/refresh). Leave empty and no
# one can call them, including you — put your own signup email here once
# you've signed up.
ADMIN_EMAILS=

# Shorter access-token lifetime applied to staff (admin panel) sessions
# specifically — a stolen admin token reaches the whole admin surface, not
# just one person's own data.
STAFF_ACCESS_TTL=10m
# Optional, comma-separated, exact-match IP allowlist for /api/admin/* (no
# CIDR ranges). Leave empty (the default) to allow any IP.
ADMIN_IP_ALLOWLIST=

# See /docs/GETTING_API_KEYS.md for how to get each of these for real.
# While these are left as placeholders, the app runs in dev/mock mode automatically.
# OTP codes are delivered by email (via Resend) — no approval/template wait,
# works the moment a real key is set here.
EMAIL_API_KEY=REPLACE_WITH_YOUR_KEY
# Optional — defaults to Resend's own shared test address if left unset.
# Only needs changing once you've verified your own domain in Resend.
EMAIL_FROM=
# Optional — a real, monitored mailbox (e.g. support@yourdomain.com) that a
# customer's email reply to a SUPPORT-TICKET email goes to. Applies to ticket
# emails only (never sign-in codes or marketing). Leave empty and a reply goes
# to EMAIL_FROM's own address. The mailbox must actually exist — Resend only
# sends, it doesn't receive. See docs/ADMIN_PANEL_SETUP_GUIDE.md §5.1.
SUPPORT_REPLY_TO=
# Marketing sender — used for campaigns to people who aren't Divve users
# (Admin -> Notifications -> Email lists) AND for campaigns in a notification
# category whose email sender is "marketing" (the seeded "marketing" category).
# It must be a DIFFERENT address from
# EMAIL_FROM above (your no-reply address for sign-in codes), on a domain
# verified in Resend, so marketing spam complaints can never affect OTP
# delivery. There is no fallback: leave it unset and those campaigns won't
# send (other categories keep sending from EMAIL_FROM as before). See docs/ADMIN_PANEL_SETUP_GUIDE.md §6.3.
MARKETING_EMAIL_FROM=
# Optional — where replies to marketing emails go (leave empty if no-reply).
MARKETING_EMAIL_REPLY_TO=
# Optional — the public base URL of this API INCLUDING /api (e.g.
# https://divve.in/api), used for the unsubscribe link in marketing emails to
# imported contacts. Defaults to <first CORS origin>/api in production and
# http://localhost:<PORT>/api in development.
PUBLIC_API_URL=
CRYPTO_PRICE_API_KEY=REPLACE_WITH_YOUR_KEY

# Power AI-based holdings extraction for the Bot Scanner and image/PDF file
# uploads (vision + structured output). OPENAI_API_KEY (GPT-5.6 Terra) is the
# PRIMARY extraction call; ANTHROPIC_API_KEY (Claude Sonnet 5) is the
# FALLBACK, used automatically if the OpenAI call fails or OPENAI_API_KEY is
# left blank. Set at least one for these two ingestion paths to work — with
# neither set, they return a clear "not configured" error rather than guessing.
OPENAI_API_KEY=REPLACE_WITH_YOUR_KEY
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_KEY

FINVU_BASE_URL=https://finvu-sandbox.example/api
FINVU_CLIENT_ID=REPLACE_ME
FINVU_CLIENT_SECRET=REPLACE_ME
FINVU_CERT_PATH=

PUBLIC_BASE_URL=http://localhost:8000

# Razorpay — powers the paid (Rs. 99) resilience-score PDF download. See
# /docs/RAZORPAY_SETUP_GUIDE.md for how to get these, including how to keep
# them separate from a Razorpay account you already use for another product.
# While these are left as placeholders, that download runs in a clearly-
# labeled mock-payment mode instead of calling the real Razorpay API.
RAZORPAY_KEY_ID=REPLACE_WITH_YOUR_KEY
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY
# Optional — only needed once you've set up a webhook (see the guide's §5).
# Leaving this blank just means that reliability net is off; the primary
# payment-confirmation path doesn't need it.
RAZORPAY_WEBHOOK_SECRET=
# Price of the resilience-score PDF, in paise (100 paise = Rs. 1).
REPORT_PRICE_PAISE=9900

# --- GST invoicing (Phase 6b; safe to leave blank in dev — invoices still
# generate, just marked provisional until a real GSTIN is set) ---
GST_SELLER_GSTIN=
GST_SELLER_NAME=Divve
GST_SELLER_STATE=

# --- Dunning (Phase 6b) — days a past_due subscription keeps Premium access
# before it's automatically cancelled ---
DUNNING_GRACE_DAYS=7

# --- Cancel notice buffer — hours before a cancelled-but-still-active
# subscription's renewal date that Razorpay is actually told to stop
# auto-renewing (deferred so reactivating before this point never touches
# Razorpay at all — see subscriptionService.ts::cancelSubscriptionDoc) ---
CANCEL_NOTICE_BUFFER_HOURS=48

# --- Renewal reminder — comma-separated default thresholds (days before
# currentPeriodEnd) that users are warned about an upcoming renewal charge,
# trial ending, or access lapsing — each fires its own reminder
# (admin-editable at runtime; see AdminSetting key "renewalReminder") ---
RENEWAL_REMINDER_DAYS_BEFORE=7,3,0
