# CRA/craco bakes REACT_APP_* vars into the built bundle at `npm run build`
# time, not read at runtime — so for a PRODUCTION build specifically, copy
# this file to `.env.production` (not plain `.env`) and set the real backend
# URL there. CRA automatically prefers `.env.production` over `.env` during
# `npm run build`, so this is the one CRA itself treats as authoritative for
# what actually ships. (`craco.config.js` will refuse to build at all if this
# ends up unset either way — see the check there — but naming it correctly
# up front avoids relying on that safety net.)
REACT_APP_BACKEND_URL=http://localhost:8000

# Optional — browser error reporting (Sentry). Baked in at BUILD time like every
# REACT_APP_* var, so for a production build put it in `.env.production`.
# Unset = fully off: nothing is loaded and nothing is sent. Use a separate
# Sentry "React/Browser" project's DSN (a DSN is meant to be public — it only
# allows sending events). See docs/ADMIN_PANEL_SETUP_GUIDE.md §1.2.
REACT_APP_SENTRY_DSN=
# Optional — a label for which deploy an error came from (e.g. 2026.09.24 or a git hash).
REACT_APP_RELEASE=
